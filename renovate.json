{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "ignoreDeps": [
        "com.mojang:minecraft"
    ],
    "labels": [
        "dependencies"
    ],
    "packageRules": [
        {
            "description": "Correct version handling for dependencies with format major.minor.patch+mcver",
            "matchPackageNames": [
                "net.fabricmc.fabric-api:fabric-api",
                "net.fabricmc.fabric-api:fabric-api-deprecated"
            ],
            "versioning": "regex:^(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?(?:\\+(?<compatibility>.*))?$"
        },
        {
            "description": "Correct version handling for NeoForge",
            "matchPackageNames": [
                "net.neoforged:neoforge"
            ],
            "versioning": "regex:^(?<compatibility>(\\d+\\.){2})(?<minor>\\d+)(-beta)?$"
        },
        {
            "description": "Correct version handling for Paper",
            "matchPackageNames": [
                "io.papermc.paper:dev-bundle"
            ],
            "versioning": "regex:^(?<compatibility>.+)\\.build\\.(?<minor>\\d+)(?:-[a-z]+)?$"
        }
    ],
    "semanticCommitType": "build",
    "commitMessagePrefix": "chore(deps): "
}
